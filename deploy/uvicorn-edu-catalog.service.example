# systemd unit для Uvicorn. Установка на сервере:
#
#   sudo cp deploy/uvicorn-edu-catalog.service.example /etc/systemd/system/edu-catalog-api.service
#   sudo nano /etc/systemd/system/edu-catalog-api.service   # поправьте User, пути
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now edu-catalog-api
#   sudo systemctl status edu-catalog-api
#
# Логи: journalctl -u edu-catalog-api -f

[Unit]
Description=Edu catalog API (FastAPI / Uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/edu-catalog/repo/backend
EnvironmentFile=/var/www/edu-catalog/repo/backend/.env
ExecStart=/var/www/edu-catalog/repo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
