# Пример systemd для Uvicorn (положить в /etc/systemd/system/, поправить пути и пользователя).
# Путь к проекту: /var/www/edu-catalog/repo (или свой).

[Unit]
Description=Edu catalog API (FastAPI)
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/edu-catalog/repo/backend
EnvironmentFile=/var/www/edu-catalog/repo/backend/.env
ExecStart=/var/www/edu-catalog/repo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
