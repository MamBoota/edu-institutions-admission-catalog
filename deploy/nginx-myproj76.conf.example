# Полный пример vhost для myproj76.ru (VPS / свой Nginx).
# На shared REG.RU проще вставить deploy/ispmanager-nginx-snippet.conf в панель.
#
# Статика: frontend/dist → /var/www/edu-catalog/html
# API:     Uvicorn на 127.0.0.1:8000

upstream edu_api {
    server 127.0.0.1:8000;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name myproj76.ru www.myproj76.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name myproj76.ru www.myproj76.ru;

    # Пути к сертификатам Let's Encrypt (REG.RU / certbot) — поправьте под сервер:
    ssl_certificate     /etc/letsencrypt/live/myproj76.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/myproj76.ru/privkey.pem;

    root /var/www/edu-catalog/html;
    index index.html;

    # API — до location / !
    location ^~ /api/ {
        proxy_pass http://edu_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location = /api {
        return 301 /api/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
