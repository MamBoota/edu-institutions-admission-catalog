# Пример Nginx для домена myproj76.ru (HTTPS — сертификаты по инструкции REG.RU).
# Статика фронта: каталог с содержимым frontend/dist после `npm run build`.
# API: Uvicorn на 127.0.0.1:8000.

upstream edu_api {
    server 127.0.0.1:8000;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name myproj76.ru www.myproj76.ru;
    # Редирект на HTTPS после настройки сертификата:
    # return 301 https://$host$request_uri;

    root /var/www/edu-catalog/html;
    index index.html;

    location /api/ {
        proxy_pass http://edu_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# После получения TLS — дублируйте server { listen 443 ssl; ... } по шаблону REG.RU.
