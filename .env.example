# --- Backend Settings (Python) ---
# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edu_catalog_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Application settings
SECRET_KEY=super_secret_key_change_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: JWT or Session config if needed later
# JWT_EXPIRATION_HOURS=24

# --- Frontend Settings (React) ---
# API Base URL for frontend to connect to backend
REACT_APP_API_URL=http://localhost:8000/api
# Or VITE_API_URL=http://localhost:8000/api if using Vite